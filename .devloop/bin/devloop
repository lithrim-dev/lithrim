#!/usr/bin/env python3
"""devloop — tiny CLI for the .devloop/ scaffold.

Read-only operations only. Mutations are the user's job (or the slash
commands).

Subcommands:
  devloop status                       Dashboard JSON (streams, phases, seams)
  devloop streams                      List streams in this repo
  devloop seams [--severity high]      List open seams
  devloop bundles                      List registered prompt bundles
  devloop kickoff <stream> <phase>     Print the executor kickoff for a cycle
  devloop validate                     Validate task packs + session logs + index
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent  # .devloop/
REPO = ROOT.parent


def _load(path: Path):
    if not path.exists():
        return None
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as e:
        print(f"warn: failed to parse {path}: {e}", file=sys.stderr)
        return None


def cmd_status(args):
    streams = _load(ROOT / "state" / "streams.json") or {"streams": []}
    bundles = _load(ROOT / "prompts" / "index.json") or {"bundles": []}
    session_logs = sorted((ROOT / "sessions").glob("session-*.json"))
    critiques = sorted((ROOT / "sessions").glob("critique-*.md"))
    seams = _collect_seams()

    print(json.dumps({
        "repo": REPO.name,
        "generated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
        "stream_count": len(streams.get("streams", [])),
        "active_streams": [s for s in streams.get("streams", []) if s.get("status") == "active"],
        "open_seams_by_severity": _by_severity(seams),
        "recent_sessions": [str(p.relative_to(REPO)) for p in session_logs[-5:]],
        "recent_critiques": [str(p.relative_to(REPO)) for p in critiques[-5:]],
        "bundle_count": len(bundles.get("bundles", [])),
    }, indent=2))


def cmd_streams(args):
    streams = _load(ROOT / "state" / "streams.json") or {"streams": []}
    for s in streams.get("streams", []):
        print(f"{s.get('id', '?'):30}  {s.get('status', '?'):10}  phase {s.get('current_phase', '?')}  {s.get('name', '')}")


def cmd_seams(args):
    seams = _collect_seams()
    if args.severity:
        seams = [s for s in seams if s.get("severity") == args.severity]
    for s in seams:
        print(f"{s['id']:20}  {s.get('severity', '?'):8}  {s['stream']:25}  {s['title']}")


def cmd_bundles(args):
    bundles = _load(ROOT / "prompts" / "index.json") or {"bundles": []}
    for b in bundles.get("bundles", []):
        print(f"{b['id']:50}  {b.get('status', '?'):10}  {b.get('hardness', 'routine'):10}  {b.get('file', '?')}")


def cmd_kickoff(args):
    template = (ROOT / "prompts" / "KICKOFF_EXECUTOR.md").read_text()
    scope = args.scope or "<SCOPE>"
    print(template
          .replace("<STREAM>", args.stream)
          .replace("<N>", args.phase)
          .replace("<SCOPE>", scope))


def cmd_validate(args):
    errors = []
    # streams.json basic shape
    streams = _load(ROOT / "state" / "streams.json")
    if streams is None:
        errors.append("state/streams.json missing or unparseable")
    elif not isinstance(streams.get("streams"), list):
        errors.append("state/streams.json: 'streams' must be a list")
    # prompts/index.json
    bundles = _load(ROOT / "prompts" / "index.json")
    if bundles is None:
        errors.append("prompts/index.json missing or unparseable")
    # session logs
    for log_path in (ROOT / "sessions").glob("session-*.json"):
        log = _load(log_path)
        if log is None:
            errors.append(f"{log_path}: unparseable")
            continue
        for c in log.get("commits", []):
            h = c.get("hash", "")
            if not h or "<" in h or "resolve via" in h:
                errors.append(f"{log_path}: commit has placeholder hash: {h!r}")
        if log.get("verdict") not in ("CLEAN", "PROCEED-WITH-CAVEATS", "BLOCKED", None):
            errors.append(f"{log_path}: invalid verdict {log.get('verdict')!r}")
    if errors:
        for e in errors:
            print(f"FAIL  {e}")
        sys.exit(1)
    print("OK  validation passed")


def _collect_seams():
    seams = []
    streams = _load(ROOT / "state" / "streams.json") or {"streams": []}
    for s in streams.get("streams", []):
        state_md = ROOT / "state" / s.get("state_doc", "")
        if not state_md.exists():
            continue
        text = state_md.read_text()
        # Crude table extraction: lines starting with | S- ...
        for m in re.finditer(r"\|\s*(S-[A-Z0-9-]+)\s*\|\s*(.+?)\s*\|\s*(high|medium|low)\s*\|\s*(.+?)\s*\|", text):
            seams.append({
                "id": m.group(1),
                "title": m.group(2),
                "severity": m.group(3),
                "fix_location": m.group(4),
                "stream": s["id"],
            })
    return seams


def _by_severity(seams):
    out = {"high": 0, "medium": 0, "low": 0}
    for s in seams:
        out[s.get("severity", "low")] = out.get(s.get("severity", "low"), 0) + 1
    return out


def main():
    parser = argparse.ArgumentParser(prog="devloop")
    sub = parser.add_subparsers(dest="cmd", required=True)

    sub.add_parser("status").set_defaults(func=cmd_status)
    sub.add_parser("streams").set_defaults(func=cmd_streams)
    p_seams = sub.add_parser("seams")
    p_seams.add_argument("--severity", choices=["high", "medium", "low"])
    p_seams.set_defaults(func=cmd_seams)
    sub.add_parser("bundles").set_defaults(func=cmd_bundles)
    p_kick = sub.add_parser("kickoff")
    p_kick.add_argument("stream")
    p_kick.add_argument("phase")
    p_kick.add_argument("--scope", default=None)
    p_kick.set_defaults(func=cmd_kickoff)
    sub.add_parser("validate").set_defaults(func=cmd_validate)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
