{
  "session_id": "session-<stream>-phase<N>-YYYY-MM-DD",
  "stream": "<stream-name>",
  "phase": "<N>",
  "driver_bundle_id": "<stream>-phase<N>-<scope>-driver",
  "started_at": "YYYY-MM-DDTHH:MM:SSZ",
  "ended_at": "YYYY-MM-DDTHH:MM:SSZ",
  "executor": "claude-code",
  "target_repos": ["<repo>"],

  "plan_review": {
    "posted_at": "YYYY-MM-DDTHH:MM:SSZ",
    "user_approved_at": "YYYY-MM-DDTHH:MM:SSZ",
    "deviations": [
      {
        "kind": "APPROVED-AT-PLAN | APPROVED-MID-CYCLE | REJECTED-MID-CYCLE | CITATION-DRIFT",
        "summary": "<one-liner>",
        "evidence": "<quote or file:line>",
        "decided_at": "YYYY-MM-DDTHH:MM:SSZ"
      }
    ]
  },

  "commits": [
    {
      "hash": "<real-sha-no-placeholders>",
      "repo": "<repo>",
      "title": "feat(<scope>): <title>",
      "summary": "<one-line summary of what this commit does>"
    }
  ],

  "acceptance": [
    {
      "criterion": "A1 — <from driver §5>",
      "verdict": "PASS | FAIL | SKIP",
      "evidence": "<test output snippet, command + result, file:line, etc>"
    }
  ],

  "diagnostic_stats": {
    "<stat name>": "<value>"
  },

  "seams_opened": [
    {
      "id": "S-<STREAM-uppercased>-<N>",
      "title": "<short title>",
      "severity": "high | medium | low",
      "fix_location": "<file or layer>",
      "impact": "<one-line impact statement>",
      "confidence": "CONFIRMED | INFERRED | HYPOTHESIS",
      "evidence": "<verbatim quote or file:line if CONFIRMED>"
    }
  ],

  "seams_closed": ["S-<id>"],

  "verdict": "CLEAN | PROCEED-WITH-CAVEATS | BLOCKED",

  "report": "<short prose summary the monitor reads on return. 3-6 sentences. Include what landed, what's open, what the monitor should check first on audit.>",

  "next_session_hint": "<one line: 'monitor should run /devloop-audit <stream> <N> next' or similar>"
}
